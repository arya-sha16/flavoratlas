# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flavoratlas?schema=public"
# For Docker Compose setup:
# DATABASE_URL="postgresql://postgres:postgres@db:5432/flavoratlas?schema=public"

# Cache Configuration (Redis)
# For local development:
REDIS_URL="redis://localhost:6379"
# For Docker Compose setup:
# REDIS_URL="redis://redis:6379"

# Security & JWT Secrets
JWT_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
BCRYPT_SALT_ROUNDS=12

# Google OAuth 2.0 (Passport.js)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# Email Verification (Nodemailer / SMTP)
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your-smtp-user"
EMAIL_PASS="your-smtp-password"
EMAIL_FROM="noreply@flavoratlas.com"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ----------------------------------------------------
# GLOBAL FOOD & RECIPE API KEYS
# ----------------------------------------------------

# 1. YouTube Data API v3 (For video cooking tutorials)
# Get key from: https://console.cloud.google.com/
YOUTUBE_API_KEY="your-youtube-data-api-v3-key"

# 2. TheMealDB API Key (Free global recipe API - defaults to public test key '1')
# Get key from: https://www.themealdb.com/api.php
THEMEALDB_API_KEY="1"

# 3. Spoonacular Food & Nutrition API
# Get key from: https://spoonacular.com/food-api/console#Dashboard
SPOONACULAR_API_KEY="your-spoonacular-api-key"

# 4. Edamam Recipe Search API
# Get credentials from: https://developer.edamam.com/edamam-recipe-api
EDAMAM_APP_ID="your-edamam-app-id"
EDAMAM_APP_KEY="your-edamam-app-key"

# 5. Google Gemini AI API (For dynamic cultural food & recipe generation)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Client URL
CLIENT_URL="http://localhost:5173"
